rules_version = '2';

// Règles de sécurité Firebase Storage pour unmillion.fr
// À déployer : `firebase deploy --only storage`
service firebase.storage {
  match /b/{bucket}/o {
    // Images des pixels, rangées par utilisateur : pixels/{uid}/...
    match /pixels/{uid}/{allPaths=**} {
      // Lecture publique (affichées sur le canvas).
      allow read: if true;
      // Seul l'utilisateur authentifié peut écrire dans son dossier,
      // avec une image de taille raisonnable (< 5 Mo).
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
